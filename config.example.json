{
  "protocol": {
    "version": "1.0.0",
    "defaultPrivacyLevel": "STEALTH",
    "minPrivacyScore": 0.7,
    "enableStealthAddresses": true,
    "enableZKProofs": true,
    "enableMixing": true,
    "mixingDelayMs": 5000,
    "encryptionAlgorithm": "nacl"
  },
  "arbitrage": {
    "enabled": true,
    "minProfitThreshold": 0.5,
    "maxTradeAmount": 10000,
    "markets": [
      "POLY-USDC",
      "ETH-USDC",
      "BTC-USDC"
    ]
  },
  "security": {
    "rotateKeysEvery": "7d",
    "maxTransactionAge": "5m",
    "requireSignatures": true,
    "enforcePrivacyMinimum": true
  },
  "network": {
    "rpcUrl": "https://polygon-rpc.com",
    "chainId": 137,
    "gasPrice": "auto",
    "confirmations": 2
  }
}
