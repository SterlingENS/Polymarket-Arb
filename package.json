{
  "name": "polymarket-arbitrage-bot",
  "version": "1.0.0",
  "description": "Automated arbitrage bot for Polymarket prediction markets",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && cd web && npm run build",
    "build:server": "tsc",
    "build:web": "cd web && npm run build",
    "start": "node dist/index.js",
    "start:server": "node dist/server.js",
    "dev": "ts-node src/index.ts",
    "dev:server": "ts-node src/server.ts",
    "watch": "tsc --watch"
  },
  "keywords": [
    "polymarket",
    "arbitrage",
    "trading",
    "bot"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "dotenv": "^16.3.1",
    "ethers": "^6.9.0",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/ws": "^8.5.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
